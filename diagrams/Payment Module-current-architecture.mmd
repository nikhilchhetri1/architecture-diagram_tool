flowchart TB
    accTitle: Payment Module Detailed Current-State Architecture
    accDescr: Detailed current-state architecture for the RACPad Payment module, showing CDN delivery, Cognito/Okta-federated identity, API Gateway wiring, internal Lambda code layers (handlers, validators, use cases, shared library), downstream Enterprise Alt-Pay integration, and supporting platform/CI-CD controls.

    subgraph L1["Experience & Identity"]
        direction LR
        Browser["Store Associate Browser<br/>RACPad Shell - /payment, /payment/save routes"]

        subgraph CDN["Content Delivery (CloudFront)"]
            direction TB
            CF["CloudFront Distribution<br/>default behavior -> S3 app origin"]
            EdgeLambda["Origin-Request Lambda@Edge<br/>shared resource, ARN only"]
            S3App[("S3 App Bucket<br/>CORS: racpad + menu origins only<br/>Public access blocked")]
            S3Swagger[("S3 Swagger UI Bucket<br/>RacpadCommonSwaggerBucket, shared<br/>/swagger/* cache behavior")]
            S3AppDR[("S3 App Bucket (DR)<br/>WorkloadAccount condition<br/>failover OriginGroup commented out")]
            S3SwaggerDR[("S3 Swagger Bucket (DR)<br/>WorkloadAccount condition<br/>failover OriginGroup commented out")]
        end

        subgraph AuthG["Identity"]
            direction TB
            Amplify["AWS Amplify Auth Client<br/>Auth.currentSession"]
            Cognito[("Amazon Cognito User Pool<br/>federated IdP - identities[0], custom:employeeId claim")]
        end
    end

    subgraph L2["API Boundary"]
        direction LR
        APIGW["Amazon API Gateway<br/>RAC PAD API - REST, basePath /api<br/>request validator: validateRequestBody"]
        ApiStage["API Stage<br/>TracingEnabled true, LoggingLevel INFO"]
        Authz["Custom Lambda Authorizer V2<br/>request-type, TTL 3600s, shared ARN"]
        GWResponses["Gateway Responses 401/403/500/504<br/>JSON error body + CORS + Datadog trace headers allow-listed"]
        LambdaPerms["Lambda::Permission grants<br/>scoped per method+route to apigateway.amazonaws.com"]
    end

    subgraph L3["Synchronous Services"]
        direction LR

        subgraph GetFn["GetPaymentLog Lambda - Node.js 16.x, VPC-attached"]
            direction TB
            GetHandler["handler(event)<br/>jwt-decode(Authorization), pathParameters.paymentLogId"]
            GetUseCase["getPaymentLogUseCase"]
        end

        subgraph ProcFn["ProcessPaymentLog Lambda - Node.js 16.x, VPC-attached"]
            direction TB
            ProcHandler["handler(event)<br/>ValidationService.checkHeaders - Content-Type"]
            ProcValidator["ValidationService.validatePayload<br/>AJV schema: ProcessPaymentLog (required fields, enums, maxLength)"]
            ProcUseCase["processPaymentLogUseCase"]
        end

        subgraph Shared["app-common shared library"]
            direction TB
            TokenSvc["TokenService<br/>getUserId/getEmployeeId from JWT claims"]
            PaymentRepo["paymentRepository<br/>builds Basic Auth header from secret"]
            RespHandler["responseHandler<br/>success/failure, strips stacktrace when ENVIRONMENT=prod"]
            ErrClasses["RacpadAPIError / ExternalAPIError"]
        end
    end

    subgraph L4["External Integrations & Platform Controls"]
        direction LR
        ESSApi["Enterprise Alt-Pay API - ESS/ESB<br/>GET altpay/paymentlog/id, POST altpay/payment/process<br/>owning repo not identified in reviewed evidence"]
        SecretsMgr[("AWS Secrets Manager<br/>secret: env-containerApp-payment")]
        KMS["AWS KMS<br/>racpad key + ESS SM key - decrypt secrets"]
        VPCNet["VPC / Subnets / Security Group<br/>LambdaSgId - shared network"]
        XRay["AWS X-Ray<br/>active tracing on Lambdas + API stage"]
        CWInsights["CloudWatch Logs + Lambda Insights extension"]
        NewRelic["New Relic APM<br/>conditional - NREnabled flag"]
        LaaS[("LaaS Kinesis Logging Stream<br/>cross-account writer role")]
        CICD["GitHub Actions CI/CD<br/>rac-devops-cicd-rac_cicd reusable workflow<br/>Terraform apply: dev/qa/uat/training/prod"]
    end

    Browser -->|loads SPA over HTTPS| CF
    CF -->|default behavior| S3App
    CF -->|"/swagger/* behavior"| S3Swagger
    CF -.->|origin-request trigger| EdgeLambda
    CF -.->|DR origin - inactive failover| S3AppDR
    CF -.->|DR origin - inactive failover| S3SwaggerDR

    Browser -->|sign-in| Amplify
    Amplify -->|SRP auth| Cognito
    Cognito -->|"ID token: custom:employeeId, identities[]"| Amplify

    Browser <-->|"Bearer JWT, GET/POST /api/altpay/payment-log/*"| APIGW
    APIGW --> ApiStage
    ApiStage -.->|traces + INFO logs| XRay
    APIGW -->|authorize via custom_auth_payment| Authz
    APIGW -.->|on 401/403/5xx| GWResponses
    LambdaPerms -.->|invoke grant| GetHandler
    LambdaPerms -.->|invoke grant| ProcHandler
    LambdaPerms -.->|invoke grant| Authz
    APIGW -->|aws_proxy GET| GetHandler
    APIGW -->|aws_proxy POST| ProcHandler

    GetHandler -->|extract user claims| TokenSvc
    GetHandler --> GetUseCase
    GetUseCase --> PaymentRepo

    ProcHandler -->|extract user claims| TokenSvc
    ProcHandler --> ProcValidator
    ProcValidator -->|valid payload| ProcUseCase
    ProcUseCase --> PaymentRepo

    GetHandler -.->|on error| ErrClasses
    ProcHandler -.->|on error| ErrClasses
    ErrClasses --> RespHandler

    PaymentRepo -->|"GET altpay/paymentlog/id, Basic Auth + CLIENT_ID header"| ESSApi
    PaymentRepo -->|"POST altpay/payment/process, Basic Auth + CLIENT_ID header"| ESSApi
    PaymentRepo -->|GetSecretValue| SecretsMgr
    SecretsMgr -->|decrypt| KMS

    GetFn -.->|network placement| VPCNet
    ProcFn -.->|network placement| VPCNet
    GetFn -.->|traces + logs| XRay
    GetFn -.->|traces + logs| CWInsights
    ProcFn -.->|traces + logs| XRay
    ProcFn -.->|traces + logs| CWInsights
    L3 -.->|optional APM extension layer| NewRelic
    L3 -.->|structured log shipping| LaaS

    CF -.->|Terraform deploy| CICD
    APIGW -.->|Terraform deploy| CICD
    GetFn -.->|Terraform deploy| CICD
    ProcFn -.->|Terraform deploy| CICD

    classDef identity fill:#eaf4fb,stroke:#2c79a8,color:#173a59
    classDef apilayer fill:#fff4dd,stroke:#b8860b,color:#5c4400
    classDef compute fill:#eafbea,stroke:#2f9e44,color:#164a20
    classDef sharedlib fill:#f1f8e9,stroke:#558b2f,color:#33691e
    classDef external fill:#fdeaea,stroke:#c0392b,color:#5c1a13
    classDef deploy stroke-dasharray: 4 3,fill:#f3f0fb,stroke:#6c4bb8,color:#382465
    classDef dr stroke-dasharray: 2 2,fill:#f5f5f5,stroke:#9e9e9e,color:#424242

    class Browser,Amplify,Cognito,CF,EdgeLambda,S3App,S3Swagger identity
    class S3AppDR,S3SwaggerDR dr
    class APIGW,ApiStage,Authz,GWResponses,LambdaPerms apilayer
    class GetHandler,GetUseCase,ProcHandler,ProcValidator,ProcUseCase compute
    class TokenSvc,PaymentRepo,RespHandler,ErrClasses sharedlib
    class ESSApi,SecretsMgr,KMS,VPCNet,XRay,CWInsights,NewRelic,LaaS external
    class CICD deploy

    subgraph Legend["Legend"]
        direction TB
        Lg1["Experience & Identity"]:::identity
        LgDR["DR / inactive origin"]:::dr
        Lg2["API Boundary"]:::apilayer
        Lg3["Lambda handlers/use cases"]:::compute
        LgShared["Shared app-common library"]:::sharedlib
        Lg4["External Integrations / Platform Controls"]:::external
        Lg5["CI/CD - dashed = deploy/observability edge"]:::deploy
    end

